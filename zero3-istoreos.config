# Orange Pi Zero 3 (Allwinner H618) - iStoreOS trial build
# Base: iStoreOS istoreos-24.10 (OpenWrt 24.10, kernel 6.6)

CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero3=y

# --- Wi-Fi: AW859A / UWE5622 (vendored kmod + firmware) ---
CONFIG_PACKAGE_kmod-uwe5622=y
CONFIG_PACKAGE_uwe5622-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw-full=y

# --- iStoreOS experience (explicit, normally default) ---
# tar's TAR_XZ option selects 'xz' but store/quickstart need 'xz-utils'
# specifically; without it the pair gets silently dropped by defconfig
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_LUCI_LANG_zh_Hans=y

# --- Docker ---
# iStoreOS 25.12 kernel config disables NETFILTER_XT_MATCH_PHYSDEV and IP_VS,
# which makes kmod-ipt-physdev / kmod-nf-ipvs (mandatory dockerd deps)
# unbuildable on this target
CONFIG_KERNEL_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_KERNEL_IP_VS=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# --- common utilities ---
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
